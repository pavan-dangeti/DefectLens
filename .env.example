# Copy to .env and fill in. Never commit .env.

# LLM provider keys (both free tiers). Used by evaluation/review tooling.
NVIDIA_API_KEY=
GEMINI_API_KEY=

# MLflow
MLFLOW_TRACKING_URI=file:./mlruns

# Optional overrides
DEFECTLENS_DATA_DIR=data
DEFECTLENS_ARTIFACTS_DIR=artifacts
DEFECTLENS_PORT=8000
DEFECTLENS_MAX_UPLOAD_MB=20
